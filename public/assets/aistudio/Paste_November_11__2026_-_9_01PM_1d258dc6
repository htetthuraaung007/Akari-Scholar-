                      "{followupResult.readyToSubmitReply}"
                    </p>
                  </div>
                </div>

                <div className="p-3 rounded-xl bg-slate-900 border border-slate-800 text-xs space-y-1">
                  <span className="text-[11px] font-bold text-amber-300">💡 Discourse Follow-up Question:</span>
                  <p className="text-slate-300 italic">"{followupResult.counterQuestion}"</p>
                </div>
              </div>
            ) : (
              <div className="h-72 flex flex-col items-center justify-center text-slate-500 text-xs space-y-1">
                <span>ဆရာ သို့မဟုတ် Classmate မေးထားသော မေးခွန်းကို ဘယ်ဘက်တွင် ထည့်သွင်း၍ စစ်ဆေးပါ</span>
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
};
