`;

  const userContent = `MY ORIGINAL POST EXCERPT:\n${originalPost.substring(0, 2500)}\n\nTHEIR INQUIRY (${inquirerType}):\n${theirQuestion.substring(0, 1500)}`;

  for (const model of DISCUSSION_MODELS) {
