          generationConfig: { responseMimeType: 'application/json', temperature: 0.15, maxOutputTokens: 850 }
        })
      });
      if (!res.ok) continue;
      const data = await res.json();
      const rawText = data.candidates?.[0]?.content?.parts?.[0]?.text;
      if (!rawText) continue;
