export async function generatePeerComments(
  unitTopic: string,
  classmatePost: string,
  apiKey: string
): Promise<PeerCommentsResult> {
  const cleanKey = apiKey.trim();
  const systemPrompt = `
You are an Elite Academic Peer Reviewer for University of the People.
Generate THREE distinct, high-scoring peer response comments (each strictly 110-150 words) for a classmate's discussion post.
Adhere strictly to UoPeople 3-part discussion rubric:
(1) Specific, non-generic commendation (no robotic "Overall, great post"),
(2) Conceptual extension with empirical/theoretical depth,
(3) Thought-provoking open-ended question to sustain discourse.

Return ONLY valid JSON matching this schema:
{
  "unitTopic": "Clean string of unit topic",
  "variants": [
    {
      "style": "Analytical & Methodological",
      "wordCount": 125,
      "responseBurmeseGuide": "ဤရွေးချယ်မှု၏ အဓိကထောက်ပြချက်ကို မြန်မာလို အကျဉ်းချုပ် ၁ ကြောင်း",
      "responseEnglishText": "Full academic peer response paragraph ready to post..."
    },
    {
      "style": "Empirical & Evidence-Driven",
      "wordCount": 130,
      "responseBurmeseGuide": "ဒုတိယရွေးချယ်မှု၏ အနှစ်ချုပ် ၁ ကြောင်း",
      "responseEnglishText": "Full academic peer response paragraph ready to post..."
    },
    {
      "style": "Critical Perspective & Nuance",
      "wordCount": 120,
      "responseBurmeseGuide": "တတိယရွေးချယ်မှု၏ အနှစ်ချုပ် ၁ ကြောင်း",
      "responseEnglishText": "Full academic peer response paragraph ready to post..."
    }
  ]
}
Rules: Output raw JSON only. Max 900 tokens.
`;

  const userContent = `UNIT TOPIC: ${unitTopic || 'General Coursework Topic'}\n\nCLASSMATE'S POST:\n${classmatePost.substring(0, 3500)}`;

  for (const model of DISCUSSION_MODELS) {
    try {
      const url = `[https://generativelanguage.googleapis.com/v1beta/models/$](https://generativelanguage.googleapis.com/v1beta/models/$){model}:generateContent?key=${cleanKey}`;
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ role: 'user', parts: [{ text: `${systemPrompt}\n\n${userContent}` }] }],
          generationConfig: { responseMimeType: 'application/json', temperature: 0.2, maxOutputTokens: 1100 }
        })
      });
      if (!res.ok) continue;
      const data = await res.json();
      const rawText = data.candidates?.[0]?.content?.parts?.[0]?.text;
      if (!rawText) continue;
      return JSON.parse(cleanJson(rawText));
    } catch {}
  }
  throw new Error('Peer Comments ထုတ်ယူ၍ မရပါ။ API Key သို့မဟုတ် အင်တာနက်ကို စစ်ဆေးပေးပါခင်ဗျာ။');
}

