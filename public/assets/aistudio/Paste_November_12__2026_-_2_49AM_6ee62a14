export const AssignmentWorkspace: React.FC<{ onBackToDashboard?: () => void }> = ({ onBackToDashboard }) => {
  const [activeModule, setActiveModule] = useState<AssignmentSubModule>('outline_suite');
  const [activeSubTab, setActiveSubTab] = useState<Module1SubTab>('advisor_email');

  // Global State
  const [loading, setLoading] = useState(false);
  const [copied, setCopied] = useState(false);
  const [moodleCleanerActive, setMoodleCleanerActive] = useState<boolean>(true);

  // 1A. Outline States
  const [outlineInput, setOutlineInput] = useState('');
  const [uploadedImages, setUploadedImages] = useState<{ name: string; dataUrl: string }[]>([]);
  const [outlineResult, setOutlineResult] = useState('');
  const [historyItems, setHistoryItems] = useState<string[]>(() => {
    try {
      return JSON.parse(localStorage.getItem('akari_outline_history') || '[]');
    } catch {
      return [];
    }
  });

  // 1B. Draft Audit States
  const [draftInput, setDraftInput] = useState('');
  const [instructorFeedback, setInstructorFeedback] = useState('');
  const [draftAuditResult, setDraftAuditResult] = useState('');

  // 1C. Turnitin & Free Open Source Citation Audit States
  const [integrityInput, setIntegrityInput] = useState('');
  const [integrityResult, setIntegrityResult] = useState('');
  const [freeApiAuditing, setFreeApiAuditing] = useState(false);

  // 1D. Advisor & Instructor Emergency Email States (COMPLETE SYSTEM)
  const [emailTemplateType, setEmailTemplateType] = useState<'blackout' | 'medical' | 'technical' | 'custom'>('blackout');
  const [emailCourseName, setEmailCourseName] = useState('POLS 1503 - Globalization');
  const [emailRecipientRole, setEmailRecipientRole] = useState<'instructor' | 'advisor' | 'both'>('instructor');
  const [emailInstructorName, setEmailInstructorName] = useState('Dr. Innocent Ndock Kong');
  const [emailStudentName, setEmailStudentName] = useState('Thin Yati Aung');
  const [emailStudentID, setEmailStudentID] = useState('');
  const [emailExtensionDays, setEmailExtensionDays] = useState('48 hours (2 Days)');
  const [emailCustomReason, setEmailCustomReason] = useState('');
  const [emailGenerated, setEmailGenerated] = useState(() => {
    return `Subject: Urgent Extension Request - Localized Infrastructure Disruption [POLS 1503 - Globalization]\n\nDear Dr. Innocent Ndock Kong,\n\nI hope this email finds you well.\n\nI am writing to respectfully request an academic extension of 48 hours (2 Days) for the upcoming coursework submission in POLS 1503 - Globalization. In Yangon, Myanmar, we are currently experiencing severe rolling power outages and localized telecommunication disruptions, severely impeding my regular access to the learning portal and academic resources.\n\nI have already drafted the initial analysis and will finalize and upload my submission as soon as stable electricity and network access are restored. I truly appreciate your understanding, flexibility, and continuous guidance under these challenging local circumstances.\n\nThank you very much for your time and kind consideration.\n\nSincerely,\nThin Yati Aung\nStudent ID: [Your UoPeople ID]\nUniversity of the People`;
  });
