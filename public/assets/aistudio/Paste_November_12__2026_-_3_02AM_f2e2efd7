                  className="w-full p-3 text-xs rounded-xl bg-slate-950 border border-slate-800 text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 font-mono"
                />

                <div>
                  <label className="text-[10px] text-amber-300 font-bold block mb-1">
                    ဆရာပေးထားသော Feedback / အထူးမှာကြားချက် (ရှိပါက ထည့်ရန်):
                  </label>
                  <textarea
                    rows={3}
                    value={instructorFeedback}
                    onChange={(e) => setInstructorFeedback(e.target.value)}
                    placeholder="ဥပမာ - 'Expand more on local technology in Myanmar and check APA citations'..."
                    className="w-full p-2 text-xs rounded-xl bg-slate-950 border border-slate-800 text-slate-200 placeholder-slate-600 focus:outline-none focus:border-amber-500 font-mono"
                  />
                </div>

                <button
                  type="button"
                  onClick={handleAuditDraft}
                  disabled={loading}
                  className="w-full py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs shadow transition-all flex items-center justify-center gap-2"
                >
                  {loading ? (
                    <>
                      <div className="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin" />
                      <span>ဆရာ့စံနှုန်းအတိုင်း စိစစ်နေသည်...</span>
                    </>
                  ) : (
                    <>
                      <span>🔍</span>
                      <span>ဆရာ့စံနှုန်းအတိုင်း စစ်ဆေးမည် (လိုတိုရှင်း)</span>
                    </>
                  )}
                </button>
              </div>

              <div className="lg:col-span-7 p-4 rounded-2xl bg-[#0c1222]/90 border border-slate-800 space-y-3">
                <div className="flex items-center justify-between pb-2 border-b border-slate-800">
                  <span className="text-xs font-bold text-slate-200">INSTRUCTOR AUDIT & RUBRIC MATCH ရလဒ်</span>
                  {draftAuditResult && (
                    <button type="button" onClick={() => copyCleanText(draftAuditResult)} className="text-xs text-cyan-400 hover:underline">
                      {copied ? '✓ Copied' : '📋 Copy Clean Text'}
                    </button>
                  )}
                </div>
                <div className="h-[400px] overflow-y-auto p-4 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 font-mono leading-relaxed whitespace-pre-wrap">
                  {draftAuditResult || 'Draft ထည့်သွင်းပြီး စစ်ဆေးနိုင်ပါသည် (လိုတိုရှင်း အမှတ်ပေးစည်းမျဉ်းဖြင့် ပြသပေးပါမည်)...'}
                </div>
              </div>
            </div>
          )}

          {/* 1C. TURNITIN INTEGRITY VIEW */}
          {activeSubTab === 'turnitin_integrity' && (
            <div className="space-y-4">
              <div className="grid grid-cols-1 lg:grid-cols-12 gap-4">
                <div className="lg:col-span-5 p-4 rounded-2xl bg-[#0c1222]/90 border border-slate-800 space-y-3">
                  <div className="flex items-center justify-between">
                    <span className="text-xs font-bold text-rose-300 flex items-center gap-1.5">
                      <span>🛡️</span> References စာရင်း သို့မဟုတ် TURNITIN SIMILARITY အပိုဒ်များ:
                    </span>
                    <label className="cursor-pointer text-[11px] text-indigo-400 hover:text-indigo-300 font-semibold flex items-center gap-1">
                      <span>📄 ဖိုင်တင်မည်</span>
                      <input
                        type="file"
                        accept=".docx,.pdf,.txt"
                        onChange={handleSilentFileUpload}
                        className="hidden"
                      />
                    </label>
                  </div>

                  <div className="p-2.5 rounded-xl bg-amber-950/30 border border-amber-800/40 text-[11px] text-amber-300 leading-relaxed">
                    ⚠️ <strong>သတိပေးချက်:</strong> ဤနေရာတွင် စာတမ်းတစ်ခုလုံး မထည့်ရပါ။ References စာရင်း သို့မဟုတ် Turnitin တွင် အငြင်းပွားနေသော စာကြောင်းများကိုသာ သီးသန့် ထည့်သွင်းပေးပါခင်ဗျာ။
                  </div>

                  <textarea
                    rows={11}
                    value={integrityInput}
                    onChange={(e) => setIntegrityInput(e.target.value)}
                    placeholder="References စာရင်းကို ထည့်ပါ (၁၀ နှစ်ကျော် စာအုပ်/ဂျာနယ်ဟောင်းများကို အလိုအလျောက် ထောက်ပြပေးပါမည်)..."
                    className="w-full p-3 text-xs rounded-xl bg-slate-950 border border-slate-800 text-slate-100 placeholder-slate-600 focus:outline-none focus:border-rose-500 font-mono"
                  />

                  <div className="grid grid-cols-2 gap-2">
                    <button
                      type="button"
                      onClick={handleFreeCrossrefAudit}
                      disabled={freeApiAuditing || !integrityInput.trim()}
                      className="py-2.5 px-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 text-white font-bold text-xs shadow transition-all flex items-center justify-center gap-1.5"
                    >
                      <span>🌐</span>
                      <span>{freeApiAuditing ? 'စစ်ဆေးနေပါသည်...' : 'Free DB စစ်မည် (Zero Token)'}</span>
                    </button>

                    <button
                      type="button"
                      onClick={async () => {
                        if (!integrityInput.trim()) return alert('References စာရင်း ထည့်ပါ');
                        const res = await callGemini(`Audit references for Turnitin false-positives and APA 7th:\n${integrityInput}`, 700);
                        setIntegrityResult(res);
                      }}
                      disabled={loading || !integrityInput.trim()}
                      className="py-2.5 px-3 rounded-xl bg-gradient-to-r from-rose-600 to-pink-600 hover:from-rose-500 hover:to-pink-500 disabled:opacity-50 text-white font-bold text-xs shadow transition-all flex items-center justify-center gap-1.5"
                    >
                      <span>🛡️</span>
                      <span>{loading ? 'AI စိစစ်နေပါသည်...' : 'Turnitin AI စစ်ဆေးမည်'}</span>
                    </button>
                  </div>
                </div>

                <div className="lg:col-span-7 p-4 rounded-2xl bg-[#0c1222]/90 border border-slate-800 space-y-3">
                  <div className="flex items-center justify-between pb-2 border-b border-slate-800">
                    <span className="text-xs font-bold text-slate-200">ACADEMIC INTEGRITY & 10-YEAR CITATION AUDIT ရလဒ်</span>
                    {integrityResult && (
                      <button
                        type="button"
                        onClick={() => copyCleanText(integrityResult)}
                        className="text-xs text-cyan-400 hover:underline"
                      >
                        {copied ? '✓ Copied' : '📋 Copy Report'}
                      </button>
                    )}
                  </div>
                  <div className="h-[390px] overflow-y-auto p-4 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 font-mono leading-relaxed whitespace-pre-wrap">
                    {integrityResult || 'References စာရင်း ထည့်သွင်းပြီး "Free DB စစ်မည်" သို့မဟုတ် "Turnitin AI စစ်ဆေးမည်" ကို နှိပ်ပါ...'}
                  </div>
                </div>
              </div>

              {/* EXTERNAL PLAGIARISM CHECKERS GRID */}
              <div className="p-4 rounded-2xl bg-[#0a101f] border border-slate-800 space-y-3">
                <div className="flex items-center justify-between pb-1 border-b border-slate-800/80">
                  <div className="flex items-center gap-2">
                    <span className="p-1 rounded-lg bg-cyan-950 text-cyan-400 border border-cyan-800/40">🌐</span>
                    <h4 className="text-xs font-bold text-slate-200">Online Plagiarism စစ်ဆေးသည့် ဝဘ်ဆိုဒ်များ</h4>
                  </div>
                  <span className="text-[10px] text-slate-500 font-mono">Open in New Tab ↗</span>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-3 pt-1">
                  {EXTERNAL_PLAGIARISM_TOOLS.map((tool, idx) => (
                    <a
                      key={idx}
                      href={tool.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      className="p-3 rounded-xl bg-slate-950/80 border border-slate-800 hover:border-cyan-500/50 hover:bg-slate-900 transition-all flex flex-col justify-between space-y-2 group"
                    >
                      <div className="space-y-1">
                        <div className="flex items-center justify-between">
                          <span className="text-xs font-bold text-slate-200 group-hover:text-cyan-300 transition-colors">
                            {tool.name}
                          </span>
                          <span className={`text-[9px] font-bold px-1.5 py-0.5 rounded border ${tool.badgeColor}`}>
                            {tool.badge}
                          </span>
                        </div>
                        <p className="text-[10px] text-slate-400 line-clamp-2 leading-relaxed">
                          {tool.desc}
                        </p>
                      </div>

                      <span className="text-[10px] text-cyan-400 group-hover:underline self-end flex items-center gap-1 font-semibold">
                        စစ်ဆေးရန် သွားမည် ↗
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>
      )}

      {/* MODULE 2: DISCUSSION STUDIO */}
      {activeModule === 'discussion_studio' && (
        <div className="p-4 rounded-2xl bg-[#0c1222]/90 border border-slate-800 text-xs text-slate-300">
          <span className="font-bold text-slate-100">Discussion Studio Active</span>
        </div>
      )}

      {/* MODULE 3: PARAPHRASER */}
      {activeModule === 'paraphraser' && (
        <div className="p-4 rounded-2xl bg-[#0c1222]/90 border border-slate-800 text-xs text-slate-300">
          <span className="font-bold text-slate-100">Paraphraser Active</span>
        </div>
      )}

      {/* MODULE 4: EMERGENCY RESCUER */}
      {activeModule === 'emergency_rescuer' && (
        <div className="p-4 rounded-2xl bg-[#0c1222]/90 border border-slate-800 text-xs text-slate-300">
          <span className="font-bold text-slate-100">အရေးပေါ် ၁ နာရီ Rescuer Active</span>
        </div>
      )}
    </div>
  );
};