```typescript
export type UoPeopleGrade = 'A' | 'A-' | 'B+' | 'B' | 'B-' | 'C+' | 'C' | 'C-' | 'D+' | 'D' | 'F' | 'TC';

export const GRADE_POINTS: Record<UoPeopleGrade, number | null> = {
  'A': 4.00,
  'A-': 3.67,
  'B+': 3.33,
  'B': 3.00,
  'B-': 2.67,
  'C+': 2.33,
  'C': 2.00,
  'C-': 1.67,
  'D+': 1.33,
  'D': 1.00,
  'F': 0.00,
  'TC': null // Transfer Credit: Excluded from GPA calculation, included in total earned credits
};

export interface CourseRecord {
  id: string;
  code: string;
  credits: number;
  grade: UoPeopleGrade;
}

export interface TermRecord {
  id: string;
  termName: string;
  courses: CourseRecord[];
}

export interface CgpaSummary {
  cumulativeGpa: number;
  totalGpaCredits: number;
  totalEarnedCredits: number; // Includes TC
  totalQualityPoints: number;
  honorsBadge: { label: string; color: string };
  scholarshipStatus: { safe: boolean; label: string; color: string };
}

export function calculateCgpa(terms: TermRecord[]): CgpaSummary {
  let totalQualityPoints = 0;
  let totalGpaCredits = 0;
  let totalEarnedCredits = 0;

  terms.forEach(term => {
    term.courses.forEach(course => {
      const pts = GRADE_POINTS[course.grade];
      if (pts !== null) {
        totalQualityPoints += pts * course.credits;
        totalGpaCredits += course.credits;
        if (course.grade !== 'F') {
          totalEarnedCredits += course.credits;
        }
      } else if (course.grade === 'TC') {
        totalEarnedCredits += course.credits;
      }
    });
  });

  const cumulativeGpa = totalGpaCredits > 0 
    ? Math.min(4.00, Math.round((totalQualityPoints / totalGpaCredits) * 100) / 100) 
    : 0.00;

  // Academic Honors & Standing
  let honorsBadge = { label: 'Good Standing', color: 'text-slate-300 bg-slate-800 border-slate-700' };
  if (cumulativeGpa >= 3.85 && totalEarnedCredits >= 30) {
    honorsBadge = { label: '🏆 Summa Cum Laude', color: 'text-amber-300 bg-amber-950/60 border-amber-500/40' };
  } else if (cumulativeGpa >= 3.70 && totalEarnedCredits >= 30) {
    honorsBadge = { label: '🎖️ Magna Cum Laude', color: 'text-purple-300 bg-purple-950/60 border-purple-500/40' };
  } else if (cumulativeGpa >= 3.50 && totalEarnedCredits >= 30) {
    honorsBadge = { label: '⭐ Cum Laude', color: 'text-blue-300 bg-blue-950/60 border-blue-500/40' };
  } else if (cumulativeGpa < 2.00 && totalGpaCredits >= 12) {
    honorsBadge = { label: '🚨 Academic Probation Warning', color: 'text-rose-300 bg-rose-950/60 border-rose-500/40' };
  }

  // Scholarship Standing (< 3.00 vs >= 3.00)
  const scholarshipStatus = cumulativeGpa >= 3.00
    ? { safe: true, label: '🟢 Scholarship Safe (>= 3.00)', color: 'text-emerald-300 bg-emerald-950/60 border-emerald-500/40' }
    : { safe: false, label: '⚠️ Scholarship At Risk (< 3.00)', color: 'text-amber-400 bg-amber-950/60 border-amber-500/40' };

  return {
    cumulativeGpa,
    totalGpaCredits,
    totalEarnedCredits,
    totalQualityPoints,
    honorsBadge,
    scholarshipStatus
  };
}

export interface TargetAnalysis {
  isAchieved: boolean;
  isMathematicallyImpossible: boolean;
  requiredGpa: number;
  maxAchievableGpa: number;
  recommendationText: string;
}

export function calculateTargetScenario(
  currentQualityPoints: number,
  currentGpaCredits: number,
  targetGpa: number,
  remainingCredits: number
): TargetAnalysis {
  if (remainingCredits <= 0) {
    const currGpa = currentGpaCredits > 0 ? currentQualityPoints / currentGpaCredits : 0;
    return {
      isAchieved: currGpa >= targetGpa,
      isMathematicallyImpossible: currGpa < targetGpa,
      requiredGpa: 0,
      maxAchievableGpa: currGpa,
      recommendationText: 'ကျန်ရှိသော Credit မရှိတော့ပါ။'
    };
  }

  const totalFutureCredits = currentGpaCredits + remainingCredits;
  const maxQualityPoints = currentQualityPoints + (remainingCredits * 4.00);
  const maxAchievableGpa = Math.round((maxQualityPoints / totalFutureCredits) * 100) / 100;

  const targetQualityPoints = targetGpa * totalFutureCredits;
  const neededQualityPoints = targetQualityPoints - currentQualityPoints;
  const requiredGpa = Math.round((neededQualityPoints / remainingCredits) * 100) / 100;

  if (requiredGpa > 4.00) {
    return {
      isAchieved: false,
      isMathematicallyImpossible: true,
      requiredGpa,
      maxAchievableGpa,
      recommendationText: `ကျန်ရှိသော ${remainingCredits} credits အားလုံး A (4.00) ချည်း ရခဲ့လျှင်ပင် အမြင့်ဆုံး ${maxAchievableGpa.toFixed(2)} သာ ရရှိနိုင်သဖြင့် Target GPA ${targetGpa.toFixed(2)} သည် သင်္ချာနည်းအရ မဖြစ်နိုင်တော့ပါ။ Target ကို ပြန်လည်ညှိပေးပါ။`
    };
  }

  if (requiredGpa <= (currentGpaCredits > 0 ? currentQualityPoints / currentGpaCredits : 0) && currentQualityPoints / currentGpaCredits >= targetGpa) {
    return {
      isAchieved: true,
      isMathematicallyImpossible: false,
      requiredGpa: Math.max(0, requiredGpa),
      maxAchievableGpa,
      recommendationText: `ဂုဏ်ယူပါသည်! သင်၏ လက်ရှိ CGPA သည် လိုချင်သော Target သို့ ရောက်ရှိနေပြီး ဖြစ်သည်။ ကျန်ရှိသော Course များတွင် GPA ${Math.max(2.0, requiredGpa).toFixed(2)} ခန့် ထိန်းထားရုံဖြင့် Target ကို ဆက်လက် ထိန်းသိမ်းနိုင်ပါမည်။`
    };
  }

  return {
    isAchieved: false,
    isMathematicallyImpossible: false,
    requiredGpa,
    maxAchievableGpa,
    recommendationText: `Target CGPA ${targetGpa.toFixed(2)} ရရှိရန် ကျန်ရှိသော ${remainingCredits} credit နာရီများတွင် အနည်းဆုံး ပျမ်းမျှ GPA ${requiredGpa.toFixed(2)} (${requiredGpa >= 3.67 ? 'A / A-' : requiredGpa >= 3.33 ? 'A- / B+' : 'B+ / B'} အများစု) ရရှိရန် လိုအပ်ပါသည်။`
  };
}

// Auto-generates sequential term names from existing terms
export function getNextTermName(existingTerms: TermRecord[]): string {
  if (existingTerms.length === 0) return '2026 Term 2';
  const last = existingTerms[existingTerms.length - 1].termName;
  const match = last.match(/(\d{4})\s*Term\s*(\d)/i);
  if (match) {
    let year = parseInt(match[1], 10);
    let termNum = parseInt(match[2], 10);
    if (termNum >= 5) {
      year += 1;
      termNum = 1;
    } else {
      termNum += 1;
    }
    return `${year} Term ${termNum}`;
  }
  return `Term ${existingTerms.length + 1}`;
}
