                      className="w-20 px-2 py-1.5 text-xs rounded-xl bg-slate-900 border border-slate-700 text-slate-100 focus:outline-none"
                    >
                      <option value={3}>3 hrs</option>
                      <option value={4}>4 hrs</option>
                      <option value={1}>1 hr</option>
                      <option value={2}>2 hrs</option>
                    </select>
                    <select
                      value={course.grade}
                      onChange={(e) => handleUpdateCourse(term.id, course.id, 'grade', e.target.value as UoPeopleGrade)}
                      className="w-28 px-2 py-1.5 text-xs rounded-xl bg-slate-900 border border-slate-700 text-slate-100 font-bold focus:outline-none"
                    >
                      <option value="A">A (4.00)</option>
                      <option value="A-">A- (3.67)</option>
                      <option value="B+">B+ (3.33)</option>
                      <option value="B">B (3.00)</option>
                      <option value="B-">B- (2.67)</option>
                      <option value="C+">C+ (2.33)</option>
                      <option value="C">C (2.00)</option>
                      <option value="C-">C- (1.67)</option>
                      <option value="D+">D+ (1.33)</option>
                      <option value="D">D (1.00)</option>
                      <option value="F">F (0.00)</option>
                      <option value="TC">TC (Transfer)</option>
                    </select>
                    <button
                      onClick={() => handleRemoveCourse(term.id, course.id)}
                      className="p-1.5 text-slate-500 hover:text-rose-400 text-xs transition-colors"
                    >
                      ✕
                    </button>
                  </div>
                ))}
              </div>

              {/* Add Course in Term Button */}
              <button
                onClick={() => handleAddCourse(term.id)}
                className="mt-1 text-xs text-indigo-400 hover:text-indigo-300 font-semibold flex items-center gap-1"
              >
                <span>+</span> ဘာသာရပ် ထပ်ထည့်မည်
              </button>
            </div>
          );
        })}
      </div>
    </div>
  );
};
