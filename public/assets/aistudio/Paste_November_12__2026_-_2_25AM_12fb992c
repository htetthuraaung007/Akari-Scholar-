import React, { useState } from 'react';

type AssignmentSubModule = 
  | 'outline_suite' 
  | 'discussion_studio' 
  | 'paraphraser' 
  | 'emergency_rescuer';

type Module1SubTab = 
  | 'outline' 
  | 'draft_audit' 
  | 'turnitin_integrity' 
  | 'advisor_email';

const VERIFIED_FLASH_MODELS = [
  'gemini-3.5-flash-lite',
  'gemini-3.1-flash-lite',
  'gemini-flash-lite-latest',
  'gemini-3-flash-preview',
  'gemini-3.6-flash',
  'gemini-3.8-flash',
  'gemini-flash-latest'
];

export const AssignmentWorkspace: React.FC<{ onBackToDashboard?: () => void }> = ({ onBackToDashboard }) => {
  const [activeModule, setActiveModule] = useState<AssignmentSubModule>('outline_suite');
  const [activeSubTab, setActiveSubTab] = useState<Module1SubTab>('outline');

  // Global State
  const [loading, setLoading] = useState(false);
  const [copied, setCopied] = useState(false);
  const [moodleCleanerActive, setMoodleCleanerActive] = useState<boolean>(true);

  // 1A. Outline States
  const [outlineInput, setOutlineInput] = useState('');
  const [uploadedImages, setUploadedImages] = useState<{ name: string; dataUrl: string }[]>([]);
  const [outlineResult, setOutlineResult] = useState('');
  const [historyItems, setHistoryItems] = useState<string[]>(() => {
    try {
      return JSON.parse(localStorage.getItem('akari_outline_history') || '[]');
    } catch {
      return [];
    }
  });

  // 1B. Draft Audit & Instructor Feedback States
  const [draftInput, setDraftInput] = useState('');
  const [instructorFeedback, setInstructorFeedback] = useState('');
  const [draftAuditResult, setDraftAuditResult] = useState('');

  // 1C. Turnitin & 10-Year Outdated Citation Audit
  const [integrityInput, setIntegrityInput] = useState('');
  const [integrityResult, setIntegrityResult] = useState('');

  // 1D. Emergency Email States
  const [emailTemplateType, setEmailTemplateType] = useState<'blackout' | 'medical' | 'technical' | 'custom'>('blackout');
  const [emailCourseName, setEmailCourseName] = useState('POLS 1503 - Globalization');
  const [emailInstructorName, setEmailInstructorName] = useState('Dr. Innocent Ndock Kong');
  const [emailStudentName, setEmailStudentName] = useState('Thin Yati Aung');
  const [emailCustomReason, setEmailCustomReason] = useState('');
  const [emailGenerated, setEmailGenerated] = useState('');

  // 2. Moodle Discussion Layout Transformer
  const [rawDiscussionText, setRawDiscussionText] = useState('');
  const [formattedDiscussionHtml, setFormattedDiscussionHtml] = useState('');

  // 3. Discussion Studio States
  const [discussionMode, setDiscussionMode] = useState<'peer' | 'followup'>('peer');
  const [unitTopic, setUnitTopic] = useState('');
  const [classmatePost, setClassmatePost] = useState('');
  const [discussionResult, setDiscussionResult] = useState('');

  // 4. Paraphraser States
  const [paraphraseText, setParaphraseText] = useState('');
  const [paraphraseDepth, setParaphraseDepth] = useState<'standard' | 'deep' | 'academic'>('academic');
  const [paraphraseResult, setParaphraseResult] = useState('');

  // 5. Emergency 1-Hour Generator
  const [emergencyTopic, setEmergencyTopic] = useState('');
  const [emergencyResult, setEmergencyResult] = useState('');

  // Bottom Automated Error & Compliance Checker State
  const [complianceAuditDone, setComplianceAuditDone] = useState(false);
  const [complianceIssues, setComplianceIssues] = useState<{
    indentCheck: boolean;
    subheadingsCheck: boolean;
    referencesCheck: boolean;
    linksCheck: boolean;
    outdatedCount: number;
    wordCount: number;
  }>({
    indentCheck: false,
    subheadingsCheck: false,
    referencesCheck: false,
    linksCheck: false,
    outdatedCount: 0,
    wordCount: 0
  });

  // Gemini Flash Cascade
  const callGemini = async (prompt: string, maxTokens: number = 800, imagePayload?: { name: string; dataUrl: string }[]) => {
    const apiKey = localStorage.getItem('akari_gemini_api_key_primary') || '';
    if (!apiKey.trim()) {
      alert('Gemini API Key Vault တွင် Key ဦးစွာ ထည့်သွင်းပေးပါခင်ဗျာ။');
      return '';
    }

    setLoading(true);
    let resultText = '';

    for (const model of VERIFIED_FLASH_MODELS) {
      try {
        const parts: any[] = [];
        if (imagePayload && imagePayload.length > 0) {
          imagePayload.forEach((img) => {
            const base64Data = img.dataUrl.split(',')[1];
            const mimeType = img.dataUrl.split(';')[0].split(':')[1] || 'image/jpeg';
            if (base64Data) {
              parts.push({ inlineData: { mimeType, data: base64Data } });
            }
          });
        }
        parts.push({ text: prompt });

        const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${apiKey.trim()}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contents: [{ role: 'user', parts }],
            generationConfig: {
              temperature: 0.2,
              maxOutputTokens: maxTokens
            }
          })
        });

        if (!res.ok) continue;
        const data = await res.json();
        const text = data.candidates?.[0]?.content?.parts?.[0]?.text;
        if (text) {
          resultText = text.trim();
          break;
        }
      } catch {}
    }

    setLoading(false);
    return resultText;
  };

  // Universal File Parsing
  const handleUniversalFileUpload = async (e: React.ChangeEvent<HTMLInputElement>, target: 'outline' | 'draft') => {
    const file = e.target.files?.[0];
    if (!file) return;
    const name = file.name.toLowerCase();

    try {
      if (name.endsWith('.docx')) {
        const mammoth = (window as any).mammoth;
        if (mammoth) {
          const arrayBuffer = await file.arrayBuffer();
          const res = await mammoth.extractRawText({ arrayBuffer });
          if (target === 'outline') setOutlineInput((prev) => prev + '\n\n' + res.value);
          else setDraftInput((prev) => prev + '\n\n' + res.value);
        }
      } else if (name.endsWith('.xlsx') || name.endsWith('.csv')) {
        const text = await file.text();
        const snippet = text.slice(0, 3000);
        if (target === 'outline') setOutlineInput((prev) => prev + '\n\n' + snippet);
        else setDraftInput((prev) => prev + '\n\n' + snippet);
      } else {
        const text = await file.text();
        if (target === 'outline') setOutlineInput((prev) => prev + '\n\n' + text);
        else setDraftInput((prev) => prev + '\n\n' + text);
      }
    } catch {
      alert('ဖိုင်ဖတ်ရှုရာတွင် ချို့ယွင်းချက် ဖြစ်ပေါ်ပါသည်ခင်ဗျာ။');
    }
    e.target.value = '';
  };

  const handleImageUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = e.target.files;
    if (!files) return;
    const remaining = 12 - uploadedImages.length;
    const toAdd = Array.from(files).slice(0, remaining);

    toAdd.forEach((file) => {
      const reader = new FileReader();
      reader.onload = () => {
        setUploadedImages((prev) => [...prev, { name: file.name, dataUrl: reader.result as string }]);
      };
      reader.readAsDataURL(file);
    });
    e.target.value = '';
  };

  const cleanMoodleText = (raw: string) => {
    if (!moodleCleanerActive) return raw;
    return raw
      .replace(/[\u200B-\u200D\uFEFF]/g, '')
      .replace(/[\u2018\u2019]/g, "'")
      .replace(/[\u201C\u201D]/g, '"')
      .replace(/\r\n/g, '\n')
      .replace(/\n{3,}/g, '\n\n')
      .trim();
  };

  const copyCleanText = (txt: string) => {
    if (!txt) return;
    navigator.clipboard.writeText(cleanMoodleText(txt));
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  // 1A. Generate Outline
  const handleGenerateOutline = async () => {
    if (!outlineInput.trim() && uploadedImages.length === 0) {
      return alert('Assignment မေးခွန်း သို့မဟုတ် Rubric ပုံ ထည့်သွင်းပေးပါခင်ဗျာ။');
    }
    const prompt = `Act as an expert Academic Advisor. Analyze the assignment rubric/prompt:
1. Strict Checklist for A-Grade (Rubric requirements).
2. Structured Section-by-Section Outline.
Provide direct, concise guidance in academic Burmese and English without fluff:\n${outlineInput}`;

    const res = await callGemini(prompt, 900, uploadedImages);
    if (res) {
      setOutlineResult(res);
      const newHist = [res.slice(0, 80) + '...', ...historyItems.slice(0, 3)];
      setHistoryItems(newHist);
      localStorage.setItem('akari_outline_history', JSON.stringify(newHist));
    }
  };

  // 1B. Draft Audit & Instructor Simulator
  const handleAuditDraft = async () => {
    if (!draftInput.trim()) return alert('စစ်ဆေးရန် Draft စာမူကြမ်း ထည့်သွင်းပေးပါခင်ဗျာ။');

    const prompt = `You are a strict University Course Instructor (UoPeople Standard).
Audit this student draft against the rubric criteria and instructor feedback.
RUBRIC CONTEXT: ${outlineInput.slice(0, 800) || 'Standard University Assessment Rubric'}
INSTRUCTOR FEEDBACK (IF ANY): ${instructorFeedback || 'None provided'}
STUDENT DRAFT:
${draftInput}

INSTRUCTIONS:
- Keep the response strictly concise, punchy, and clear (Under 180 words).
- Provide:
  1. 🎯 Rubric Match Grade Assessment (Met / Partially Met / Missing).
  2. 🔍 Thesis & Logic Gaps (Identify weak premises).
  3. 💡 Direct Corrections based on Instructor Feedback.`;

    const res = await callGemini(prompt, 700);
    setDraftAuditResult(res);
  };

  // 1C. Turnitin False-Positive Shield & 10-Year Outdated Reference Audit
  const handleAuditIntegrity = async () => {
    if (!integrityInput.trim()) return alert('စစ်ဆေးရန် References သို့မဟုတ် စာမူကြမ်း ထည့်ပါခင်ဗျာ။');

    const prompt = `Act as an Academic Integrity & Turnitin Specialist.
Audit the following text/citations:
1. 🛡️ Turnitin False-Positive Shield: Flag repetitive prompt headers or generic definitions causing false match.
2. ⚠️ 10-Year Currency Audit: Flag ANY citation published before 2016 (>10 years old) as outdated, and suggest recent modern peer-reviewed alternatives.
3. 📚 APA 7th Reference Audit: Ensure journal title italics, DOI format, and author structure are correct.
Keep it concise and actionable in Burmese:\n${integrityInput}`;

    const res = await callGemini(prompt, 750);
    setIntegrityResult(res);
  };

  // Automated Real-Time Error Checker (Executed at the Bottom of Module 1)
  const handleRunRealtimeErrorCheck = () => {
    const textToCheck = draftInput || outlineResult || integrityInput;
    if (!textToCheck.trim()) {
      alert('စစ်ဆေးရန် Draft သို့မဟုတ် စာမူကြမ်း ထည့်သွင်းထားခြင်း မရှိသေးပါခင်ဗျာ။');
      return;
    }

    const lines = textToCheck.split('\n').map((l) => l.trim()).filter(Boolean);
    const words = textToCheck.trim().split(/\s+/).filter(Boolean).length;

    // 1. Check Indentation & Paragraph breaks
    const hasMultipleParagraphs = lines.length >= 3;

    // 2. Subheadings Check (checks for uppercase / colon / short title lines)
    const hasHeaders = lines.some((l) => l.length < 60 && !l.endsWith('.') && !l.includes('('));

    // 3. References Check
    const hasRefHeader = lines.some((l) => l.toLowerCase() === 'references' || l.toLowerCase().startsWith('references'));

    // 4. Outdated Years (>10 Years Check: Prior to 2016)
    const yearMatches = textToCheck.match(/\b(19\d{2}|20[0-1][0-5])\b/g) || [];
    const outdatedCount = yearMatches.length;

    // 5. Links Check
    const hasLinks = /(https?:\/\/[^\s]+)/g.test(textToCheck);

    setComplianceIssues({
      indentCheck: hasMultipleParagraphs,
      subheadingsCheck: hasHeaders,
      referencesCheck: hasRefHeader,
      linksCheck: hasLinks,
      outdatedCount,
      wordCount: words
    });

    setComplianceAuditDone(true);
  };

  // Moodle Layout Engine
  const handleFormatToMoodle = () => {
    if (!rawDiscussionText.trim()) return alert('Format ပြုလုပ်လိုသော Discussion စာသားကို ထည့်ပါခင်ဗျာ။');

    const lines = rawDiscussionText.split('\n').map((l) => l.trim()).filter(Boolean);
    let wordCount = 0;
    let referencesStartIndex = -1;

    lines.forEach((line, idx) => {
      if (line.toLowerCase() === 'references' || line.toLowerCase().startsWith('references')) {
        referencesStartIndex = idx;
      }
    });

    const bodyLines = referencesStartIndex !== -1 ? lines.slice(0, referencesStartIndex) : lines;
    const refLines = referencesStartIndex !== -1 ? lines.slice(referencesStartIndex + 1) : [];

    bodyLines.forEach((l) => {
      if (!l.toLowerCase().includes('unit') && !l.toLowerCase().includes('university') && !l.toLowerCase().includes('instructor')) {
        wordCount += l.split(/\s+/).filter(Boolean).length;
      }
    });

    let html = `<div style="font-family: Arial, sans-serif; font-size: 13px; line-height: 1.6; color: #1e293b; max-width: 100%; padding: 16px; background: #ffffff; border-radius: 8px;">`;

    bodyLines.forEach((line) => {
      const isHeader = line.length < 75 && !line.endsWith('.') && !line.includes('(');
      if (isHeader) {
        html += `<p style="font-weight: bold; margin: 16px 0 6px 0; color: #0f172a;">${line}</p>`;
      } else {
        html += `<p style="text-indent: 0.5in; margin: 0 0 10px 0; text-align: justify;">${line}</p>`;
      }
    });

    html += `<p style="font-weight: 500; font-size: 12px; margin: 16px 0; color: #475569;">Word Count - ${wordCount} (not including title & references)</p>`;

    if (refLines.length > 0) {
      html += `<p style="font-weight: bold; margin: 18px 0 8px 0; color: #0f172a;">References</p>`;
      refLines.forEach((ref) => {
        const styledRef = ref.replace(
          /(https?:\/\/[^\s]+)/g,
          '<a href="$1" target="_blank" style="color: #0066cc; text-decoration: underline; word-break: break-all;">$1</a>'
        );
        html += `<p style="padding-left: 0.5in; text-indent: -0.5in; margin: 0 0 8px 0; font-size: 12px; text-align: left;">${styledRef}</p>`;
      });
    }

    html += `</div>`;
    setFormattedDiscussionHtml(html);
  };

  // Emergency Email System
  const handleSelectEmailTemplate = (type: typeof emailTemplateType) => {
    setEmailTemplateType(type);
    if (type === 'blackout') {
      setEmailGenerated(`Subject: Emergency Extension Request - Localized Power Outage & Connectivity Disruption [${emailCourseName}]

Dear ${emailInstructorName},

I hope this email finds you well.

I am writing to respectfully request an extension of 48 hours for the upcoming assignment in ${emailCourseName}. Currently, in Yangon, Myanmar, we are experiencing severe rolling power outages and localized telecommunication disruptions, severely impeding my ability to access the portal and complete my academic submission on time.

I have already completed the preliminary research and will finalize and upload the assignment as soon as power and stable internet connectivity are restored.

Thank you very much for your understanding, kindness, and continuous support.

Sincerely,
${emailStudentName}
Student ID: [Your UoPeople ID]
University of the People`);
    } else if (type === 'medical') {
      setEmailGenerated(`Subject: Urgent Academic Consideration - Medical Emergency [${emailCourseName}]

Dear ${emailInstructorName} and Program Advisor,

I am writing to formally notify you of an unexpected medical emergency that has temporarily prevented me from submitting my coursework for ${emailCourseName}.

I am currently receiving necessary medical attention and expect to resume my coursework within 3 days. I kindly request an extension under the University's mitigating circumstances policy. I am ready to provide any relevant verification if required.

Thank you very much for your consideration.

Warm regards,
${emailStudentName}`);
    } else if (type === 'technical') {
      setEmailGenerated(`Subject: Technical Portal Issue / LMS Submission Failure [${emailCourseName}]

Dear ${emailInstructorName},

I am writing to report a technical issue encountered on the UoPeople Moodle platform while attempting to submit my assignment for ${emailCourseName}. 

The submission portal encountered an unexpected timeout error during my file upload. Attached to this email is my finalized assignment file along with screenshots of the timestamped submission error for your records.

I would be extremely grateful if you could confirm receipt of this assignment or allow an override submission.

Respectfully,
${emailStudentName}`);
    } else {
      setEmailGenerated(`Subject: Formal Request for Coursework Consideration [${emailCourseName}]

Dear ${emailInstructorName},

${emailCustomReason || 'I am writing to request guidance and academic consideration regarding my coursework.'}

Thank you for your guidance.

Best regards,
${emailStudentName}`);
    }
  };

  return (
    <div className="space-y-4">
      {/* Top 4 Core Workspace Pills */}
      <div className="p-3.5 rounded-2xl bg-[#0c1222]/90 border border-slate-800 flex items-center justify-between flex-wrap gap-2">
        <div className="flex items-center gap-2">
          {onBackToDashboard && (
            <button
              type="button"
              onClick={onBackToDashboard}
              className="px-2.5 py-1 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700 text-xs font-bold transition-all"
            >
              ← Back
            </button>
          )}
        </div>

        <div className="flex items-center gap-1.5 overflow-x-auto scrollbar-none py-1">
          <button
            type="button"
            onClick={() => setActiveModule('outline_suite')}
            className={`px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap transition-all flex items-center gap-1.5 ${
              activeModule === 'outline_suite' ? 'bg-indigo-600 text-white shadow' : 'bg-slate-900/60 text-slate-400 hover:text-slate-200'
            }`}
          >
            <span>📋</span> Assignment Hub (Outline, Draft & Integrity)
          </button>

          <button
            type="button"
            onClick={() => setActiveModule('discussion_studio')}
            className={`px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap transition-all flex items-center gap-1.5 ${
              activeModule === 'discussion_studio' ? 'bg-indigo-600 text-white shadow' : 'bg-slate-900/60 text-slate-400 hover:text-slate-200'
            }`}
          >
            <span>💬</span> Discussion Studio & Moodle Formatter
          </button>

          <button
            type="button"
            onClick={() => setActiveModule('paraphraser')}
            className={`px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap transition-all flex items-center gap-1.5 ${
              activeModule === 'paraphraser' ? 'bg-indigo-600 text-white shadow' : 'bg-slate-900/60 text-slate-400 hover:text-slate-200'
            }`}
          >
            <span>📈</span> Paraphraser & Depth Controller
          </button>

          <button
            type="button"
            onClick={() => setActiveModule('emergency_rescuer')}
            className={`px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap transition-all flex items-center gap-1.5 ${
              activeModule === 'emergency_rescuer' ? 'bg-amber-600 text-white shadow' : 'bg-slate-900/60 text-slate-400 hover:text-slate-200'
            }`}
          >
            <span>⏱️</span> အရေးပေါ် ၁ နာရီ Rescuer (Emergency)
          </button>
        </div>
      </div>

      {/* MODULE 1: SUITE */}
      {activeModule === 'outline_suite' && (
        <div className="space-y-4">
          <div className="p-3.5 rounded-2xl bg-[#0c1222]/90 border border-slate-800 flex items-center justify-between flex-wrap gap-2">
            <div className="flex items-center gap-1.5 flex-wrap">
              <button
                type="button"
                onClick={() => setActiveSubTab('outline')}
                className={`px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all ${
                  activeSubTab === 'outline' ? 'bg-indigo-600 text-white shadow' : 'bg-slate-950 text-slate-400 hover:text-slate-200 border border-slate-800'
                }`}
              >
                <span>📋</span> A-Grade Outline & Checklist (12-Image)
              </button>

              <button
                type="button"
                onClick={() => setActiveSubTab('draft_audit')}
                className={`px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all ${
                  activeSubTab === 'draft_audit' ? 'bg-indigo-600 text-white shadow' : 'bg-slate-950 text-slate-400 hover:text-slate-200 border border-slate-800'
                }`}
              >
                <span>🧠</span> Draft စစ်ဆေးချက် (Logic & Rubric Match)
              </button>

              <button
                type="button"
                onClick={() => setActiveSubTab('turnitin_integrity')}
                className={`px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all ${
                  activeSubTab === 'turnitin_integrity' ? 'bg-rose-600 text-white shadow' : 'bg-slate-950 text-slate-400 hover:text-slate-200 border border-slate-800'
                }`}
              >
                <span>🛡️</span> Integrity & စာအုပ်/ဂျာနယ်အစစ်များ (Turnitin)
              </button>

              <button
                type="button"
                onClick={() => {
                  setActiveSubTab('advisor_email');
                  handleSelectEmailTemplate('blackout');
                }}
                className={`px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all ${
                  activeSubTab === 'advisor_email' ? 'bg-amber-600 text-white shadow' : 'bg-slate-950 text-slate-400 hover:text-slate-200 border border-slate-800'
                }`}
              >
                <span>✉️</span> Advisor/Instructor အရေးပေါ် Email
              </button>
            </div>

            <label className="flex items-center gap-2 cursor-pointer bg-slate-950 px-2.5 py-1 rounded-xl border border-slate-800 text-[11px] text-slate-300">
              <input
                type="checkbox"
                checked={moodleCleanerActive}
                onChange={(e) => setMoodleCleanerActive(e.target.checked)}
                className="rounded border-slate-700 text-indigo-600 focus:ring-0"
              />
              <span>Moodle သန့်စင်စနစ် (Cleaner)</span>
              <span className={`text-[10px] font-bold ${moodleCleanerActive ? 'text-emerald-400' : 'text-slate-500'}`}>
